# Local Express backend:
VITE_API_URL=/api

# Local video service:
VITE_VIDEO_API_URL=/video-api

# Vercel frontend + Vercel API:
# VITE_API_URL=/api
# VITE_VIDEO_API_URL=https://your-video-service.example.com

# Vercel request limit is about 4.5 MB, so keep this at 4 there.
VITE_MAX_UPLOAD_MB=4
VITE_MAX_VIDEO_MB=20