# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/learnify

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-secret

# ---- CORS ----
# Local dev frontend origin. On Vercel, set this to your deployed frontend URL instead.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# ---- Local AI (Ollama) ----
# Local dev: leave as-is and run `ollama serve` on this machine.
# Vercel: point this at a small always-on VPS running Ollama, e.g.
# OLLAMA_HOST=http://YOUR_VPS_IP:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Preferred name for new installs. LOCAL_LLM_MODEL below remains supported.
OLLAMA_MODEL=qwen2.5:7b
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT_MS=300000
# If Ollama is unavailable, use deterministic local extraction instead of
# failing uploads, lessons and tutor requests.
ENABLE_OFFLINE_FALLBACK=true

PORT=5000
# Vercel's request limit is about 4.5 MB; local/Express deployments can use
# a larger value.
MAX_UPLOAD_MB=4
